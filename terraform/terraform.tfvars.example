# Free Tier / credits demo profile. Do not commit terraform.tfvars.
kubernetes_version = "REPLACE_WITH_SUPPORTED_EKS_VERSION"
# GitHub-hosted runners need broad CIDR; use a private endpoint + VPC runner for production.
admin_cidr_blocks  = ["0.0.0.0/0"]
github_repository  = "YOUR_ORG/YOUR_REPO"
terraform_state_bucket = "YOUR_UNIQUE_TERRAFORM_STATE_BUCKET"
terraform_lock_table   = "YOUR_TERRAFORM_LOCK_TABLE"

# Defaults already favor Free Tier-eligible sizes that can run Airflow:
# system m7i-flex.large x2, workers t3.small from 0, db.t3.micro.
# Override only after checking: aws ec2 describe-instance-types --filters Name=free-tier-eligible,Values=true
max_worker_nodes      = 2
enable_multi_az       = false
backup_retention_days = 1
budget_limit_usd      = 40
budget_alert_email    = "YOUR_EMAIL@example.com"
