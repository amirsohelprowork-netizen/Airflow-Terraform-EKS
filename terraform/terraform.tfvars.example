# Do not commit terraform.tfvars. Use an EKS version currently supported in your region.
kubernetes_version = "REPLACE_WITH_SUPPORTED_EKS_VERSION"
# GitHub-hosted runners require 0.0.0.0/0 to reach the public EKS API.
# Production must use a private endpoint and self-hosted runner instead.
admin_cidr_blocks  = ["0.0.0.0/0"]
github_repository  = "YOUR_ORG/YOUR_REPO"
terraform_state_bucket = "YOUR_UNIQUE_TERRAFORM_STATE_BUCKET"
terraform_lock_table   = "YOUR_TERRAFORM_LOCK_TABLE"

# Demo defaults are intentionally constrained. Raise these only after performance testing.
max_worker_nodes       = 3
enable_multi_az        = false
backup_retention_days  = 1
