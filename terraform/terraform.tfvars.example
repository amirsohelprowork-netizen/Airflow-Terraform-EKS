# ================================================
# Example terraform.tfvars
# Copy this file to terraform.tfvars and fill in your values
# ================================================
# NEVER commit terraform.tfvars to git — it may contain secrets

# General
project_name = "airflow-prod"
environment  = "dev"
aws_region   = "us-east-1"

# EC2
instance_type = "t3.medium"    # 2 vCPU, 4GB RAM — good for Airflow

# Airflow
airflow_image_tag      = "2.9.2"
airflow_admin_username = "admin"
airflow_admin_password = "AirflowAdmin123!"

# Access (restrict in production!)
allowed_cidr_blocks = ["0.0.0.0/0"]
